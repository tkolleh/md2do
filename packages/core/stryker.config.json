{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/scanner/structure.ts",
    "src/scanner/index.ts:13-29",
    "src/scanner/index.ts:134-134",
    "src/scanner/index.ts:142-143",
    "src/scanner/index.ts:145-151",
    "src/scanner/index.ts:185-185",
    "src/parser/index.ts:134-293",
    "src/parser/index.ts:440-485",
    "src/parser/index.ts:591-605",
    "src/parser/index.ts:645-645",
    "src/parser/patterns.ts:128-128",
    "src/writer/index.ts:52-122",
    "src/writer/index.ts:176-184",
    "src/writer/index.ts:270-280",
    "src/writer/index.ts:345-372"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 90,
    "low": 90,
    "break": 90
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}
